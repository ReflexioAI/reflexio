# =============================================================================
# Reflexio (open source) — example environment file
# =============================================================================
# Copy to `.env` and fill in the values you need. The open-source CLI runs with
# SQLite storage and no auth by default, so the only thing you must set is one
# LLM provider key.
#
# LEGEND:
#   (optional) = safe to leave empty; code default shown
#   options:   = allowed values for a categorical variable
# =============================================================================

# =============================================================================
# 1. LLM PROVIDER KEYS
# =============================================================================
# Set at least one API key. The system auto-detects available providers and
# selects appropriate default models per role (generation, evaluation,
# should_run and pre_retrieval).
#
# Provider priority when multiple keys are set:
#   Anthropic > Gemini > OpenRouter > DeepSeek > MiniMax > DashScope > xAI >
#   Moonshot > ZAI > OpenAI
# Embeddings use the configured org model, or the local MiniLM default;
# cloud API key availability does not change that model choice.
#
# Generation model resolution order (highest priority first):
#   1. Org-level LLMConfig override
#   2. Non-empty values in
#      reflexio/server/site_var/site_var_sources/llm_model_setting.json
#   3. Auto-detected default for the primary available provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# =============================================================================
# 2. OBSERVABILITY (optional)
# =============================================================================
# Set to enable Braintrust LLM observability (https://www.braintrust.dev).
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT_NAME=reflexio

# =============================================================================
# 3. STORAGE
# =============================================================================
# Local storage directory — houses disk-storage artifacts and the SQLite
# database file (reflexio.db). (optional; default ~/.reflexio/data/)
LOCAL_STORAGE_PATH=
# Default org id for no-auth / local mode. Controls the request org, and hence
# the config file name (config_<org>.json) and the SQLite data scope. Override
# it to run a second local backend under a distinct org so the two don't collide
# on the same config file under ~/.reflexio/. (optional; default self-host-org)
REFLEXIO_DEFAULT_ORG_ID=self-host-org

# =============================================================================
# 4. EXTRACTION
# =============================================================================
# Per-interaction content token budget when formatting interactions into an
# extraction/evaluation prompt. When an interaction's content exceeds this many
# tokens, the first half and last half are kept (head + tail) and the middle is
# elided. (optional; default 512; set <= 0 to disable slicing and pass full
# content)
REFLEXIO_MAX_INTERACTION_CONTENT_TOKENS=512
# Concurrent durable extraction turns per process; acquired before a user lease.
# options: positive integer (optional; defaults to publish concurrency, currently 4)
REFLEXIO_PUBLISH_LEARNING_WORKERS=4
# Pickup latency versus discovery read load.
# options: finite positive seconds within the platform wait range (default 2)
REFLEXIO_DURABLE_LEARNING_POLL_SECONDS=2
# Renewable background claim lifetime and worker-loss recovery.
# options: positive integral seconds within epoch/heartbeat headroom (default 300)
REFLEXIO_DURABLE_LEARNING_LEASE_SECONDS=300
# Process-owned resumable follow-up pickup cadence, independent of org opt-in.
# Local resolutions wake the scheduler. This is the poll after a sweep that
# found work; consecutive idle sweeps double it up to a fixed 60s ceiling (or
# this value, if larger), so cross-process pickup waits at most that long.
# options: finite positive seconds <= threading.TIMEOUT_MAX; default: 5
REFLEXIO_RESUME_POLL_INTERVAL_SECONDS=5
# Non-renewable run claim lifetime shared by claim, discovery and recovery.
# This is distinct from the renewable user-extraction lease above.
# options: integer seconds from 1 through 357913941; default: 600
REFLEXIO_RESUME_CLAIM_TTL_SECONDS=600
# Inactivity delay in seconds before a quiet session is evaluated by agent-success
# evaluation. (optional; default 600 = 10 minutes)
GROUP_EVALUATION_DELAY_SECONDS=600
# Background repair for interactions whose embedding failed at ingest. Runs
# per-org on the shared lineage-GC scheduler. This preset keeps repair off:
# set a positive cap (e.g. 200) to enable bounded repair; 0 disables it.
# options: nonnegative integer (runtime default 200; this preset opts out)
# Remove every REFLEXIO_MISSING_VECTOR_BACKFILL_ENABLED assignment before upgrade;
# its presence (including blank or false) is rejected. Use CAP=0 to disable.
REFLEXIO_MISSING_VECTOR_BACKFILL_CAP=0
# Bounded per-tick org fan-out width for the lineage-GC / expiry-reclamation
# scheduler. SQLite storage is pinned to serial (1) regardless of this value.
# (optional; default 8; non-numeric or <=0 falls back to default)
REFLEXIO_SCHEDULER_ORG_WORKERS=
# Max current user playbooks a single playbook-aggregation run will cluster.
# Above this the run is skipped rather than sampled down, so results stay
# reproducible. This bounds CPU, not memory: clustering runs on raw vectors, so
# peak RSS stays ~flat, but runtime grows quadratically. Measured on 512-dim
# embeddings: 5k -> 8s, 10k -> 32s, 20k -> 126s. Aggregation shares a vCPU with
# request serving, so the default is set at roughly a 2-minute run.
# (optional; default 20000; non-numeric or <=0 falls back to default)
REFLEXIO_MAX_CLUSTERING_PLAYBOOKS=20000
# Shared drained-cycle coalescing interval. New signals preserve its due time;
# actionable backlog and retry paths retain their separate delays.
#   options: positive integer seconds within signed-64-bit epoch headroom (default 3600)
REFLEXIO_AGGREGATION_MIN_INTERVAL_SECONDS=3600
# Wait for an aggregation concurrency slot. Zero means immediate admission only.
#   options: finite nonnegative seconds <= threading.TIMEOUT_MAX (default 1)
REFLEXIO_AGGREGATION_CONCURRENCY_TIMEOUT_SECONDS=1
# Both settings are supported again; valid custom values are honored. Malformed,
# nonpositive intervals and negative/nonfinite waits fail validation before work.

# Shared inference service. Leave the URL empty for the separately supervised
# colocated process. Set it to a remote base URL (without /v1) to suppress the
# local child and route health discovery, embeddings, and reranking remotely.
# Explicit cloud embedding model names still bypass this service.
# Options: cloud/local_service/internal_service/off/empty. Default: empty.
REFLEXIO_EMBEDDING_PROVIDER=
REFLEXIO_EMBEDDING_SERVICE_URL=

# Whole-feature reranker gate. When false, the shared inference service skips
# model loading/prewarm and the main app makes no reranker requests.
# Options: true/false. Default: true.
REFLEXIO_RERANK_ENABLED=true
# Reranking uses the configured shared embedding service/daemon URL.
# Automatic search silently skips reranking when the ordinary loopback daemon
# is unavailable; remote/internal service failures are reported and fail open.
# Read timeout for reranker service calls, in ms. (optional; default 5000)
REFLEXIO_RERANK_SERVICE_TIMEOUT_MS=5000

# =============================================================================
# 5. TESTING & LOGGING
# =============================================================================
# Verbose debug logging to console.  options: true | false
REFLEXIO_LOG_PROFILE=verbose
# Mark the process as a test environment.  options: true | false
IS_TEST_ENV=true
# Return canned LLM responses instead of calling providers.  options: true | false
MOCK_LLM_RESPONSE=false
# Override the base directory for log files. The .reflexio/logs suffix is always
# preserved, so e.g. REFLEXIO_LOG_DIR=/tmp/foo writes logs to
# /tmp/foo/.reflexio/logs/. (optional; default $HOME -> ~/.reflexio/logs/)
REFLEXIO_LOG_DIR=

# Enforce the 5-second server-arrival deadline for POST /api/search.
# options: true | false; default: true. False retains timing and connection recovery.
REFLEXIO_SEARCH_DEADLINE_ENABLED=true
# Bulk embedding HTTP budget; searches retain their existing deadline.
# options: positive integer milliseconds. Default 2000; dedicated CPU deployments use 30000.
REFLEXIO_EMBEDDING_BULK_TIMEOUT_MS=2000
# Standalone OSS server Bearer key and SDK credential. Default: unset/blank.
# options: unset/blank (loopback clients only), a strong secret (all clients authenticate).
# Set before starting the server when allowing network access; use TLS via a proxy.
REFLEXIO_API_KEY=

# Durable, source-preserving extraction overflow admission. Enable only when all
# extraction/resume workers support the protocol; admitted runs keep draining.
# options: true | false. default: false.
REFLEXIO_EXTRACTION_OVERFLOW_ENABLED=false
# Effective model or model@api_base input/context capacities. Custom endpoints
# require explicit positive integer declarations. Requests reserve output and
# a 20% input margin; target 32768, source chunks 48, provider attempts 128.
# options: JSON object of model keys to positive integers. default: {}.
REFLEXIO_LLM_CONTEXT_LIMITS_JSON={}

# Optional isolated search reranker; must match the query embedding endpoint.
# Empty preserves shared reranking.
REFLEXIO_SEARCH_RERANK_SERVICE_URL=

# Default row ceiling PER operational table (not an aggregate database budget).
# Customer-data caps and the fixed exposure-event limit remain independent.
# options: nonnegative integer; default: 250000; zero disables inherited caps.
REFLEXIO_OPERATIONAL_ROW_LIMIT=250000
# Optional independent operational overrides; blank/unset inherits the default
# above. options: nonnegative integer; zero disables only that target's cap.
# Upgrade: an explicit old 250000 override plus a different shared default is
# ambiguous and rejected. Remove the override to inherit; for independent caps
# including 250000, unset the shared setting and configure differing targets.
REFLEXIO_ROW_LIMIT_RETRIEVED_LEARNING_EVALUATION=
REFLEXIO_ROW_LIMIT_OFFLINE_TUNER_REWARD_LABEL=
REFLEXIO_ROW_LIMIT_SHARE_LINKS=
REFLEXIO_ROW_LIMIT_AGENT_PLAYBOOK_SOURCE_USER_PLAYBOOKS=
REFLEXIO_ROW_LIMIT_PLAYBOOK_OPTIMIZATION_JOBS=
REFLEXIO_ROW_LIMIT_PLAYBOOK_OPTIMIZATION_CANDIDATES=
REFLEXIO_ROW_LIMIT_PLAYBOOK_OPTIMIZATION_EVALUATIONS=
REFLEXIO_ROW_LIMIT_PLAYBOOK_OPTIMIZATION_EVENTS=
REFLEXIO_ROW_LIMIT_PLAYBOOK_RETRIEVAL_LOGS=
# Shared Torch intra-op thread budget; unset leaves Nomic autodetection intact.
# options: positive integer or empty; default: empty
REFLEXIO_INFERENCE_TORCH_THREADS=

# Shared maintenance cadence, captured at startup. Retention holds/ages/limits
# remain independent; this is not an off switch. Blank/unset uses the default.
# options: positive integer seconds within platform timer range (default 86400)
REFLEXIO_MAINTENANCE_INTERVAL_SECONDS=86400

# Preserve python-dotenv file-loading opt-out for isolated tools; process-level
# validation still applies. options: 1/true/t/yes/y or false (default false).
# Set in the process environment to suppress reading this file.
PYTHON_DOTENV_DISABLED=false
